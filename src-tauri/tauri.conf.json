{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deskmate",
  "version": "0.1.0",
  "identifier": "com.deskmate.app",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deskmate",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/desktop-buddy/**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "../defaults/": "defaults/"
    }
  }
}